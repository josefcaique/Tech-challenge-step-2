# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nenhuma dessas variáveis é obrigatória para rodar o pipeline localmente
# (os valores padrão em src/pipeline/_mlflow.py e src/train_model.py já
# funcionam out-of-the-box com SQLite local), mas permitem apontar o
# tracking/registry do MLflow para outro backend sem alterar código.

# URI do tracking server do MLflow (ex.: sqlite:///mlflow.db, http://localhost:5000)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# URI do model registry do MLflow (geralmente igual ao tracking URI)
MLFLOW_REGISTRY_URI=sqlite:///mlflow.db

# Necessário quando o tracking URI aponta para um arquivo/SQLite local
MLFLOW_ALLOW_FILE_STORE=true
