# Poetry
poetry.lock.bak

# DVC — dados/modelos versionados via DVC, não via Git (os .dvc/*.dvc ficam no git)
/data/raw/*
!/data/raw/*.dvc
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/models/*
!/models/.gitkeep

# DVC remote local (fica só na máquina do dev, não vai pro git)
/.dvcstore/

# Métricas do pipeline DVC são versionadas via git (dvc.yaml usa cache: false)
!/metrics/*.json

